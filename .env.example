# ===== Telegram =====
# Токен от @BotFather: создай бота командой /newbot и вставь токен сюда
BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# ===== OpenRouter (ИИ для проверки предложений) =====
# Бесплатный ключ: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Модели через запятую: если первая перегружена (429), бот пробует следующую.
# Список бесплатных: https://openrouter.ai/models?max_price=0
OPENROUTER_MODELS=baidu/ernie-5.5-flash-preview:free,nvidia/nemotron-3.5-lightning:free,recursive/flint-v1.0:free,openrouter/free

# ===== Расписание =====
# Сколько заданий в день и в каком часовом окне
TASKS_PER_DAY=2
WINDOW_START_HOUR=10
WINDOW_END_HOUR=15

# Часовой пояс (IANA), например Europe/Moscow. Пусто = время этого компьютера
TIMEZONE=

# ===== Прочее =====
DB_PATH=bot.db

# Авто-остановка через N минут (для GitHub Actions). Локально оставь пустым или 0
MAX_RUN_MINUTES=
